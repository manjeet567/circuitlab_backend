# ==========================================
# CircuitLab 3D Configuration
# ==========================================

# Backend API Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
# Provide a MongoDB connection string. If omitted or unreachable,
# the backend gracefully falls back to an in-memory/embedded store for zero-setup local operation.
MONGODB_URI=mongodb://127.0.0.1:27017/circuitlab3d

# Frontend Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
