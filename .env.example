# ==========================================
# CircuitLab 3D Backend Environment Variables
# ==========================================

PORT=4000
NODE_ENV=development

# Allowed Frontend Origins for CORS
# Can be a single URL, comma-separated URLs, or "*" to allow any origin:
# Examples:
#   CLIENT_URL=http://localhost:3000
#   CLIENT_URL=https://circuitlab-3d.vercel.app,http://localhost:3000
#   CORS_ORIGIN=*
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=*

# MongoDB Database URI
# Provide a MongoDB connection string (e.g. MongoDB Atlas).
# If omitted or unreachable, backend gracefully falls back to embedded in-memory storage.
MONGODB_URI=mongodb://127.0.0.1:27017/circuitlab3d
